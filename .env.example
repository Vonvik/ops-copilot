# ---------- General ----------
ENV=development

# ---------- Postgres ----------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ops_copilot_dev
POSTGRES_PORT=5432

# ---------- Backend Security ----------
SECRET_KEY=changeme

# ---------- Frontend / NextAuth ----------
NEXTAUTH_URL=http://localhost:3000
