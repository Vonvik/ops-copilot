# ---------- API URLs ----------
# Cliente (browser) llama a localhost
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# SSR (desde contenedor frontend) llama por el nombre del servicio Docker
INTERNAL_API_URL=http://api:8000/api/v1
